# IONOS SFTP details: IONOS control panel → Hosting → SFTP & SSH
# Copy this file to .env.deploy (which is not committed) and fill it in.
IONOS_HOST=access-XXXXXXXXXX.webspace-host.com
IONOS_USER=acc-XXXXXXXXXX
# Folder on the webspace that chaconlab.org points to (Domains → chaconlab.org → Usage)
IONOS_DIR=/chaconlab
